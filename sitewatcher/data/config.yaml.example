# Optional configuration. Omitted values use built-in defaults.
defaults:
  http_timeout_s: 10
  latency_warn_ms: 800
  latency_crit_ms: 2000
  tls_warn_days: 30
  checks:
    http_basic: true
    tls_cert: true
    ping: true
    whois: true
    ip_change: true
    keywords: false
    deface: false
    rkn_block: false
    ip_blacklist: false
    ports: false
    malware: false

scheduler:
  enabled: true
  interval_minutes: 1             # scheduler tick; per-check intervals below
  run_on_startup: true
  domains_concurrency: 5
  per_domain_concurrency: 4
  domain_timeout_s: 120

schedules:
  http_basic: { interval_minutes: 5, cache_ttl_minutes: 2 }
  tls_cert: { interval_minutes: 1440, cache_ttl_minutes: 1440 }
  ping: { interval_minutes: 5, cache_ttl_minutes: 0 }
  whois: { interval_minutes: 1440, cache_ttl_minutes: 1440 }

alerts:
  enabled: true
  policy: overall_change           # overall_change | worsen_only | all
  cooldown_sec: 300

# Other settings retain their defaults. Set one only when needed.
# http:
#   proxy: http://proxy.example:3128
# malware:
#   vt_api_key: "your-key"
# rkn:
#   index_db_path: /var/lib/sitewatcher/z_i_index.db
# domains:
#   - name: example.com
#     keywords: ["homepage phrase"]
#     checks:
#       keywords: true
