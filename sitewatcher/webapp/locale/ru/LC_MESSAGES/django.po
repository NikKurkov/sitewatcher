msgstr[2] "%(count)s доменов"

#, python-format
msgid "%(count)s healthy"
msgstr "Без проблем — %(count)s"

#, python-format
msgid "%(count)s paused"
msgstr "Приостановлено — %(count)s"

#, python-format
msgid "%(count)s without current results"
msgstr "Без актуальных результатов — %(count)s"

