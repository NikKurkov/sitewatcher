msgstr ""
"Сначала показаны избранные домены. Процентные показатели относятся к HTTP-"
"проверкам за выбранный период."

msgid "Status"
msgstr "Статус"

msgid "HTTP history"
msgstr "История HTTP"

msgid "Actions"
msgstr "Действия"

msgid "Some checks are overdue"
msgstr "Некоторые проверки просрочены"

