msgid "%(count)s domain needs attention"
msgid_plural "%(count)s domains need attention"
msgstr[0] "%(count)s домен требует внимания"
msgstr[1] "%(count)s домена требуют внимания"
msgstr[2] "%(count)s доменов требуют внимания"

