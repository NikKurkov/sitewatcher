msgid "Unable to sign in with these credentials."
msgstr "Не удалось войти с указанными учётными данными."

msgid "Settings unavailable; reload the page"
msgstr "Настройки недоступны; обновите страницу"

msgid "Invalid request"
msgstr "Некорректный запрос"

msgid "Paused"
msgstr "Приостановлено"

msgid "Critical"
msgstr "Критическая ошибка"

msgid "Warning"
msgstr "Предупреждение"

msgid "Healthy"
msgstr "Всё в порядке"

msgid "No data"
msgstr "Нет данных"

msgid "Settings error"
msgstr "Ошибка настроек"

msgid "All domains"
msgstr "Все домены"

msgid "Problems"
msgstr "Проблемы"

msgid "Warnings"
msgstr "Предупреждения"

msgid "Overdue"
msgstr "Проверка просрочена"

msgid "Monitoring unavailable"
msgstr "Мониторинг недоступен"

#, python-format
msgid "Domains added: %(count)s"
msgstr "Добавлено доменов: %(count)s"

msgid "Domain saved"
msgstr "Домен сохранён"

msgid "Confirm deletion first"
msgstr "Сначала подтвердите удаление"

msgid "No domains to check"
msgstr "Нет доменов для проверки"

msgid "Another manual check is running"
msgstr "Уже выполняется другая ручная проверка"

msgid "Checks completed; results saved"
msgstr "Проверки завершены; результаты сохранены"

msgid "Domain updated"
msgstr "Домен обновлён"

msgid "Notification preference saved"
msgstr "Настройка уведомлений сохранена"

msgid "Choose a file or pasted CSV, not both"
msgstr "Выберите один источник: файл или текст CSV"

#, python-format
msgid "CSV: %(added)s added, %(updated)s updated, %(skipped)s skipped"
msgstr ""
"CSV: добавлено — %(added)s, обновлено — %(updated)s, пропущено — %(skipped)s"

msgid ". Some rows were not imported."
msgstr ". Некоторые строки не импортированы."

msgid "Read-only workspace"
msgstr "Рабочее пространство доступно только для чтения"

msgid "Settings changed; reload the domain before resetting"
msgstr "Настройки изменились; обновите страницу домена перед сбросом"

msgid "Invalid action; reload the page"
msgstr "Некорректное действие; обновите страницу"

msgid "Checks timed out; inspect saved results before retrying"
msgstr ""
"Время проверки истекло; изучите сохранённые результаты перед повторным "
"запуском"

msgid "Operation failed; inspect saved state before retrying"
msgstr ""
"Операция не выполнена; проверьте сохранённые данные перед повторной попыткой"

msgid "Method not allowed"
msgstr "Метод не поддерживается"

msgid "Language"
msgstr "Язык"

msgid "Choose the language of your workspace."
msgstr "Выберите язык рабочего пространства."

msgid "Timezone"
msgstr "Часовой пояс"

msgid "Dates and times use your selected timezone."
msgstr "Дата и время отображаются в выбранном часовом поясе."

msgid "Telegram notifications"
msgstr "Уведомления в Telegram"

msgid "Enabled"
msgstr "Включены"

msgid "Disabled"
msgstr "Выключены"

msgid "Chat ID"
msgstr "ID чата"

msgid "New bot token"
msgstr "Новый токен бота"

msgid "Choose a valid timezone from the list."
msgstr "Выберите часовой пояс из списка."

msgid "Choose English or Russian."
msgstr "Выберите английский или русский язык."

msgid "Choose Enabled or Disabled."
msgstr "Выберите «Включены» или «Выключены»."

msgid "Enter a nonzero numeric Telegram chat ID."
msgstr "Введите числовой ID чата Telegram, отличный от нуля."

msgid "From date"
msgstr "Дата с"

msgid "To date"
msgstr "Дата по"

msgid "Check"
msgstr "Проверка"

msgid "State"
msgstr "Состояние"

msgid "All checks"
msgstr "Все проверки"

msgid "All states"
msgstr "Все состояния"

msgid "The end date must not be before the start date."
msgstr "Конечная дата не может быть раньше начальной."

msgid "Date range is out of bounds."
msgstr "Указан недопустимый диапазон дат."

msgid "The saved Telegram connection could not be read. Save a new bot token."
msgstr ""
"Не удалось прочитать сохранённые настройки Telegram. Сохраните новый токен "
"бота."

msgid "Settings saved."
msgstr "Настройки сохранены."

msgid "Settings could not be saved. Reload and check before retrying."
msgstr ""
"Не удалось сохранить настройки. Обновите страницу и проверьте их перед "
"повторной попыткой."

msgid "Add a bot token before connecting to Telegram."
msgstr "Добавьте токен бота перед подключением к Telegram."

msgid "Choose a chat below, then save it as your destination."
msgstr "Выберите чат ниже и сохраните его для отправки уведомлений."

msgid ""
"No chats found. Send /start to your bot and try again, or enter a chat ID in "
"Advanced."
msgstr ""
"Чаты не найдены. Отправьте боту /start и повторите поиск или введите ID чата "
"в дополнительных настройках."

msgid "Choose a chat destination before sending a test."
msgstr "Выберите чат перед отправкой тестового уведомления."

msgid "Test notification sent to the effective destination shown below."
msgstr "Тестовое уведомление отправлено в действующий чат, указанный ниже."

msgid ""
"Telegram could not complete the request. Check the token and destination. If "
"finding chats, another process may be polling or a webhook may be enabled; "
"enter a chat ID in Advanced, or stop polling before trying again."
msgstr ""
"Telegram не смог выполнить запрос. Проверьте токен и чат назначения. Поиску "
"чатов может мешать другой процесс, получающий обновления, или включённый "
"вебхук. Введите ID чата в дополнительных настройках или остановите получение "
"обновлений перед повторной попыткой."

msgid "Website availability"
msgstr "Доступность сайта"

msgid "TLS certificate"
msgstr "Сертификат TLS"

msgid "Required keywords"
msgstr "Обязательные ключевые слова"

msgid "Defacement markers"
msgstr "Признаки подмены страницы"

msgid "Ping reachability"
msgstr "Доступность по ping"

msgid "RKN domain blocking"
msgstr "Блокировка домена РКН"

msgid "RKN IP listing"
msgstr "IP-адрес в реестре РКН"

msgid "Legacy RKN blocking"
msgstr "Блокировка РКН (устаревшая проверка)"

msgid "TCP ports"
msgstr "TCP-порты"

msgid "Domain registration"
msgstr "Регистрация домена"

msgid "IP blocklists"
msgstr "Чёрные списки IP-адресов"

msgid "IP address changes"
msgstr "Изменения IP-адреса"

msgid "Malware detection"
msgstr "Обнаружение вредоносного кода"

msgid "A domain or parent-domain listing is Critical."
msgstr ""
"Наличие домена или родительского домена в реестре считается критической "
"ошибкой."

msgid ""
"An IPv4 listing is Warning; it may concern another domain on shared hosting."
msgstr ""
"Наличие IPv4-адреса в реестре считается предупреждением: оно может "
"относиться к другому домену на общем хостинге."

msgid "OK"
msgstr "Норма"

msgid "WARN"
msgstr "Предупреждение"

msgid "CRIT"
msgstr "Критическая ошибка"

msgid "UNKNOWN"
msgstr "Нет данных"

msgid "Check this value."
msgstr "Проверьте это значение."

msgid "Enter keywords separated by commas; quote phrases containing commas."
msgstr ""
"Введите ключевые слова через запятую; фразы с запятыми заключайте в кавычки."

msgid "Enter TCP ports (1–65535) or ranges, separated by commas."
msgstr "Введите TCP-порты (1–65535) или диапазоны через запятую."

msgid "Enter a supported proxy URL with a host."
msgstr "Введите URL поддерживаемого прокси с указанием хоста."

msgid "Choose a valid proxy action."
msgstr "Выберите допустимое действие с прокси."

msgid "This domain is already monitored."
msgstr "Этот домен уже отслеживается."

msgid "Enter a valid hostname, such as example.com."
msgstr "Введите корректное имя хоста, например example.com."

msgid "Enter at most 50 domains."
msgstr "Введите не более 50 доменов."

msgid "On"
msgstr "Вкл."

msgid "Off"
msgstr "Выкл."

msgid "Check interval (minutes)"
msgstr "Интервал проверки (минуты)"

msgid "Request timeout (seconds)"
msgstr "Время ожидания ответа (секунды)"

msgid "Slow response warning (ms)"
msgstr "Предупреждение о медленном ответе (мс)"

msgid "Slow response critical (ms)"
msgstr "Критически медленный ответ (мс)"

msgid "Certificate warning (days before expiry)"
msgstr "Предупреждение об истечении сертификата (дней до окончания)"

msgid "Not found"
msgstr "Не найдено"

msgid "Available"
msgstr "Доступен"

msgid "Unavailable"
msgstr "Недоступен"

msgid "No recent data"
msgstr "Нет актуальных данных"

msgid "Select only domains in your workspace."
msgstr "Выбирайте только домены из своего рабочего пространства."

msgid "Enable public status first"
msgstr "Сначала включите публичную страницу"

msgid "Public status updated."
msgstr "Настройки публичной страницы обновлены."

msgid "Public status settings temporarily unavailable; reload Settings."
msgstr ""
"Настройки публичной страницы временно недоступны; обновите страницу настроек."

msgid "Skip to content"
msgstr "Перейти к содержимому"

msgid "Main navigation"
msgstr "Основная навигация"

msgid "Overview"
msgstr "Обзор"

msgid "Settings"
msgstr "Настройки"

msgid "Dark theme"
msgstr "Тёмная тема"

msgid "Website monitoring"
msgstr "Мониторинг сайтов"

#, python-format
msgid "Times in %(timezone)s"
msgstr "Время: %(timezone)s"

msgid "· SiteWatcher"
msgstr "· SiteWatcher"

msgid "← All domains"
msgstr "← Все домены"

msgid "Domain history"
msgstr "История домена"

msgid "Last checked"
msgstr "Последняя проверка"

msgid "Edit domain"
msgstr "Изменить домен"

msgid "Check now"
msgstr "Проверить сейчас"

msgid "Resume monitoring"
msgstr "Возобновить мониторинг"

msgid "Pause monitoring"
msgstr "Приостановить мониторинг"

msgid "Remove domain"
msgstr "Удалить домен"

msgid ""
"Monitoring settings need attention. Saved settings and history are unchanged."
msgstr ""
"Проверьте настройки мониторинга. Сохранённые настройки и история не изменены."

msgid "Recover domain settings"
msgstr "Восстановить настройки домена"

msgid "HTTP observations"
msgstr "HTTP-проверки"

msgid "Successful checks"
msgstr "Успешные проверки"

#, python-format
msgid "%(successful)s successful · %(failed)s failed"
msgstr "Успешных — %(successful)s · неудачных — %(failed)s"

#, python-format
msgid "%(percent)s%% failed"
msgstr "Неудачных — %(percent)s%%"

msgid "Recorded checks"
msgstr "Сохранённые проверки"

#, python-format
msgid "%(count)s unknown"
msgstr "Без определённого результата — %(count)s"

msgid "Latest HTTP observation"
msgstr "Последняя HTTP-проверка"

msgid ""
"No HTTP observations in this period. New results appear after an HTTP check "
"runs."
msgstr ""
"За этот период нет HTTP-проверок. Новые результаты появятся после выполнения "
"HTTP-проверки."

#, python-format
msgid ""
"%(scheduled)s scheduled · %(manual)s manual · %(legacy)s legacy observations"
msgstr ""
"По расписанию — %(scheduled)s · вручную — %(manual)s · старых записей — "
"%(legacy)s"

msgid "Latest monitoring checks"
msgstr "Последние проверки мониторинга"

msgid "· Overdue"
msgstr "· Проверка просрочена"

msgid "Checks unavailable until settings are recovered."
msgstr "Проверки недоступны до восстановления настроек."

msgid "No checks enabled."
msgstr "Нет включённых проверок."

msgid "Recent check history"
msgstr "История последних проверок"

msgid "Filter"
msgstr "Фильтр"

msgid "Reset filters"
msgstr "Сбросить фильтры"

#, python-format
msgid "Dates use %(timezone)s. Up to 100 matching results are shown."
msgstr ""
"Даты указаны в часовом поясе %(timezone)s. Показаны последние 100 подходящих "
"результатов."

#, python-format
msgid "Latest 100 saved check results · %(timezone)s"
msgstr "Последние 100 сохранённых результатов · %(timezone)s"

msgid "Checked"
msgstr "Время проверки"

msgid "Result"
msgstr "Результат"

msgid "No results match these filters."
msgstr "По выбранным фильтрам результатов нет."

msgid "No saved check results."
msgstr "Нет сохранённых результатов проверок."

msgid "Add domain"
msgstr "Добавить домен"

msgid "Monitoring"
msgstr "Мониторинг"

msgid "Adjust what SiteWatcher checks for this domain."
msgstr "Настройте проверки SiteWatcher для этого домена."

msgid "Start with your workspace defaults or customize the checks below."
msgstr ""
"Используйте настройки рабочего пространства по умолчанию или настройте "
"проверки ниже."

msgid "Settings were not saved."
msgstr "Настройки не сохранены."

msgid "Reload saved settings"
msgstr "Загрузить сохранённые настройки"

msgid "The basics"
msgstr "Основное"

msgid "Domain"
msgstr "Домен"

msgid ""
"Enter up to 50 domains separated by commas, for example example.com, "
"example.org. The settings below apply to every domain. No paths are needed."
msgstr ""
"Введите до 50 доменов через запятую, например example.com, example.org. "
"Настройки ниже применятся ко всем доменам. Пути указывать не нужно."

msgid "A hostname, such as example.com. No path is needed."
msgstr "Имя хоста, например example.com. Путь указывать не нужно."

msgid "Leave blank to use the default schedule. Use 0 to pause monitoring."
msgstr ""
"Оставьте пустым для расписания по умолчанию. Укажите 0, чтобы приостановить "
"мониторинг."

msgid "Advanced checks and settings"
msgstr "Дополнительные проверки и настройки"

msgid ""
"Optional checks and overrides for this domain. Default follows your "
"workspace configuration."
msgstr ""
"Дополнительные проверки и индивидуальные настройки домена. Значение по "
"умолчанию берётся из настроек рабочего пространства."

msgid "Timing and thresholds"
msgstr "Интервалы и пороговые значения"

msgid ""
"Separate keywords with commas, for example welcome, shop. Quote phrases "
"containing commas: \"Hello, world\". Blank uses the default; - clears the "
"list."
msgstr ""
"Разделяйте ключевые слова запятыми, например welcome, shop. Фразы с запятыми "
"заключайте в кавычки: \"Hello, world\". Пустое поле — значение по умолчанию; "
"- очищает список."

msgid ""
"Separate ports or ranges with commas, for example 1-1024, 2205. Valid ports: "
"1–65535. Blank uses the default; - clears the list."
msgstr ""
"Разделяйте порты или диапазоны запятыми, например 1-1024, 2205. Допустимые "
"порты: 1–65535. Пустое поле — значение по умолчанию; - очищает список."

msgid "Proxy"
msgstr "Прокси"

msgid "A proxy is configured."
msgstr "Прокси настроен."

msgid "No proxy configured."
msgstr "Прокси не настроен."

msgid "Credentials are never displayed."
msgstr "Учётные данные никогда не отображаются."

msgid "Proxy action"
msgstr "Действие с прокси"

msgid "Keep existing override"
msgstr "Сохранить индивидуальную настройку"

msgid "Use workspace proxy"
msgstr "Использовать прокси рабочего пространства"

msgid "Clear override (use common client)"
msgstr "Сбросить настройку (использовать общий клиент)"

msgid "Set a new proxy"
msgstr "Задать новый прокси"

msgid "New proxy URL"
msgstr "URL нового прокси"

msgid ""
"Choose Set a new proxy to apply this value. Re-enter it after a validation "
"error."
msgstr ""
"Выберите «Задать новый прокси», чтобы применить это значение. После ошибки "
"проверки введите его повторно."

msgid "Save settings"
msgstr "Сохранить настройки"

msgid "Cancel"
msgstr "Отмена"

msgid "Recover settings · SiteWatcher"
msgstr "Восстановление настроек · SiteWatcher"

msgid "← Domain history"
msgstr "← История домена"

msgid "Invalid domain settings"
msgstr "Некорректные настройки домена"

msgid ""
"Saved settings cannot be used. They have been kept unchanged. Reset the "
"overrides to use workspace defaults, then edit the domain again."
msgstr ""
"Сохранённые настройки нельзя использовать. Они оставлены без изменений. "
"Сбросьте индивидуальные настройки, чтобы использовать настройки рабочего "
"пространства по умолчанию, затем снова отредактируйте домен."

msgid "Sign in · SiteWatcher"
msgstr "Вход · SiteWatcher"

msgid "Your monitoring workspace"
msgstr "Ваше рабочее пространство мониторинга"

msgid "Welcome back"
msgstr "С возвращением"

msgid "Sign in to SiteWatcher."
msgstr "Войдите в SiteWatcher."

msgid "Sign in"
msgstr "Войти"

msgid "Forgot your password? Contact the person who manages this installation."
msgstr "Забыли пароль? Обратитесь к администратору этой установки."

msgid "Settings · SiteWatcher"
msgstr "Настройки · SiteWatcher"

msgid "Workspace"
msgstr "Рабочее пространство"

msgid "Import domains"
msgstr "Импорт доменов"

msgid ""
"Re-select the file or paste the CSV again. Private CSV content is not "
"redisplayed."
msgstr ""
"Выберите файл или вставьте CSV повторно. Конфиденциальное содержимое CSV "
"повторно не отображается."

#, python-format
msgid ""
"Remove <strong>%(domain)s</strong> and its saved check history? This cannot "
"be undone."
msgstr ""
"Удалить <strong>%(domain)s</strong> и сохранённую историю проверок? Это "
"действие нельзя отменить."

#, python-format
msgid "Type %(domain)s to confirm removal"
msgstr "Введите %(domain)s для подтверждения удаления"

msgid "Remove domain and history"
msgstr "Удалить домен и историю"

msgid "Upload a CSV backup or paste its contents. Choose one source."
msgstr ""
"Загрузите резервную копию CSV или вставьте её содержимое. Выберите один "
"источник."

msgid "CSV file"
msgstr "Файл CSV"

msgid "Or paste CSV text"
msgstr "Или вставьте текст CSV"

msgid "Import mode"
msgstr "Режим импорта"

msgid "Merge into existing overrides"
msgstr "Объединить с текущими индивидуальными настройками"

msgid "Replace overrides for listed domains"
msgstr "Заменить индивидуальные настройки указанных доменов"

msgid ""
"Domains absent from the CSV stay unchanged. Replace removes omitted "
"overrides for each listed domain."
msgstr ""
"Домены, которых нет в CSV, не изменятся. При замене у каждого указанного "
"домена удаляются индивидуальные настройки, отсутствующие в CSV."

msgid "Import CSV"
msgstr "Импортировать CSV"

msgid "Overview · SiteWatcher"
msgstr "Обзор · SiteWatcher"

msgid "Monitoring summary"
msgstr "Сводка мониторинга"

