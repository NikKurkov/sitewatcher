msgstr "Найти домен"

msgid "Find a domain…"
msgstr "Найти домен…"

msgid "Filter domains"
msgstr "Фильтр доменов"

msgid "Domains"
msgstr "Домены"

msgid ""
"Domains, with favorites first. Historical percentages describe HTTP checks "
