# Required for bot mode. Keep the real token in .env, outside git.
TELEGRAM_TOKEN=replace-me

# Restrict access to these Telegram user IDs (comma-separated).
TELEGRAM_ALLOWED_USER_IDS=

# Optional settings:
# TELEGRAM_ALERT_CHAT_ID=-1001234567890
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# DATABASE_PATH=./sitewatcher.db

# Django web bootstrap (legacy web CLI stays in use until authenticated routes land).
# The default key is a persistent mode-0600 <DATABASE_PATH>.web-secret file.
# Set SITEWATCHER_WEB_SECRET_KEY through deployment secret management to override it.
# Keep explicit hosts; wildcard hosts are rejected.
# SITEWATCHER_WEB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Enable only behind your own HTTPS reverse proxy with forwarded headers sanitized:
# SITEWATCHER_WEB_TRUST_PROXY=1
# SITEWATCHER_WEB_HTTPS=1
# Disable access logging at the server AND reverse proxy to protect future public links.
