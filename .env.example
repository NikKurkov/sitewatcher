# Required for bot mode. Keep the real token in .env, outside git.
TELEGRAM_TOKEN=replace-me

# Restrict access to these Telegram user IDs (comma-separated).
TELEGRAM_ALLOWED_USER_IDS=

# Optional settings:
# TELEGRAM_ALERT_CHAT_ID=-1001234567890
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# DATABASE_PATH=./sitewatcher.db
